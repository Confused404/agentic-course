# Copy to .env (make setup does this). Never commit .env.
# The only key you need. With it alone, every model alias is a free OpenRouter model (see config/models.toml).
OPENROUTER_API_KEY=
# Optional: Claude direct from Anthropic (fast/mid/top become Claude; paid).
ANTHROPIC_API_KEY=
# Optional: direct OpenAI instead of via OpenRouter
OPENAI_API_KEY=

# Optional: which alias table to use: auto (default) | free | openrouter | direct. `make check-env` shows it.
# COURSE_MODELS=auto
# Optional: point one alias somewhere else without editing config/models.toml, e.g.
# AGENTLAB_ALIAS_LOCAL=ollama:qwen3:8b

# Hard cap per process in USD. Every live call is charged against it (agentlab/costs.py).
COURSE_BUDGET_USD=1.00

# Record prompts/outputs in traces (runs/traces). Turn off if you trace real customer data.
TRACE_CONTENT=1

# Optional: also send traces to a local collector, e.g. Phoenix (see nodes/00-setup/README.md)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006   # base URL; the exporter adds /v1/traces

# Node 17: the launch API. A random secret of at least 32 bytes (python -c "import secrets; print(secrets.token_hex(32))").
# LAUNCH_TOKEN_SECRET=
# Only for local testing: enables POST /api/v2/dev/token, which issues tokens to anyone who asks.
# LAUNCH_DEV_TOKENS=1
